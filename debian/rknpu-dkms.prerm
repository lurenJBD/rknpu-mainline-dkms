#!/bin/sh
set -e

case "$1" in
    remove|upgrade|deconfigure)
        # Unload rknpu if loaded
        if lsmod | grep -q '^rknpu'; then
            echo "[RKNPU-DKMS] Unloading rknpu module before package removal..." >&2
            rmmod rknpu 2>/dev/null || true
        fi
        ;;
    failed-upgrade)
        ;;
    *)
        ;;
esac

#DEBHELPER#

exit 0
